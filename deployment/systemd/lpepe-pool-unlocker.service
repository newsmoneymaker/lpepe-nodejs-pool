[Unit]
Description=LuckyPepe pool: block unlocker (credits the miners after the coinbase maturity)
After=lpepe-pool-redis.service lpepe-node.service
Requires=lpepe-pool-redis.service
[Service]
Type=simple
User=lpepepool
WorkingDirectory=/opt/lpepe-nodejs-pool
ExecStart=/usr/bin/node /opt/lpepe-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
