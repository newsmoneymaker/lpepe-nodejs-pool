[Unit]
Description=LuckyPepe node (bitcoind fork): the chain, the block templates and the pool wallet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lpepepool
# luckypepe.conf: server=1, listen=1, rpcuser/rpcpassword, rpcbind=127.0.0.1, rpcport=9778, port=9777, addnode=<peers>, see docs/INSTALL.md
ExecStart=/opt/lpepe/bin/bitcoind -datadir=/opt/lpepe/data -conf=/opt/lpepe/data/luckypepe.conf -printtoconsole
Restart=on-failure
RestartSec=30
LimitNOFILE=65536
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
