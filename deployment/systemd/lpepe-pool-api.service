[Unit]
Description=LuckyPepe pool: public API (127.0.0.1:8129)
After=lpepe-pool-redis.service lpepe-node.service
Requires=lpepe-pool-redis.service
[Service]
Type=simple
User=lpepepool
WorkingDirectory=/opt/lpepe-nodejs-pool
ExecStart=/usr/bin/node /opt/lpepe-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
